    function usunWdowy(tekst) {
        if (!tekst) return "";
        let wynik = tekst;
        const regex = / (w|z|i|o|a|u|do|na|za|ze|od|we|po|nr|lub) /gi;
        wynik = wynik.replace(regex, ' $1&nbsp;');
        wynik = wynik.replace(regex, ' $1&nbsp;');
        wynik = wynik.replace(/>(w|z|i|o|a|u|do|na|za|ze|od|we|po|nr|lub) /gi, '>$1&nbsp;');
        wynik = wynik.replace(/ (Art\.|art\.|ust\.|poz\.|pkt) /g, ' $1&nbsp;');
        return wynik;
    }

