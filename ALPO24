    function handleBackBtn() {
        if (isPhaseViewActive) {
            const currentPhaseDiv = document.querySelector('.algorithm-phase:not([style*="display: none"])');
            if (currentPhaseDiv && currentPhaseDiv.id.startsWith('faza-')) {
                let phaseIdx = parseInt(currentPhaseDiv.id.replace('faza-', ''));
                if (phaseIdx > 0) {
                    openPhase(phaseIdx - 1);
                    return;
                }
            }
            // Z fazy 0 wracamy do menu wyboru
            document.getElementById("algorithm-phase-content").style.display = "none";
            document.getElementById("algorithm-menu").style.display = "block";
            isPhaseViewActive = false;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
            resetToSearch();
        }
    }

