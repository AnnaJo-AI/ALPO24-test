                `<div class="section-heading">I. Co się stało? (Istota czynu)</div><div class="sub-section"><div>- Na czym dokładnie polegało oszustwo? (np. zakup towaru, fałszywy link, oszustwo "na policjanta").</div></div><div class="sub-section"><div>- Jaka jest dokładna kwota poniesionej straty?</div></div>`,
                `<div class="section-heading">II. Gdzie i jak doszło do kontaktu?</div><div class="sub-section"><div>- Przez jaką platformę/stronę sprawca nawiązał kontakt z pokrzywdzonym?</div></div><div class="sub-section"><div>- Jakie były dokładne dane kontaktowe sprawcy?</div></div>`,
                `<div class="section-heading">III. Kiedy do tego doszło? (Chronologia)</div><div class="sub-section"><div>- Kiedy sprawca nawiązał pierwszy kontakt?</div></div><div class="sub-section"><div>- Kiedy dokładnie pokrzywdzony dokonał przelewu lub przekazał gotówkę?</div></div>`,
                `<div class="section-heading">IV. Mechanizm działania (Wprowadzenie w błąd)</div><div class="sub-section"><div>- Jakich argumentów, tzw. "legendy", użył sprawca?</div></div><div class="sub-section"><div>- Pod kogo podszywał się sprawca?</div></div><div class="sub-section"><div>- Czy pokrzywdzony sam podał kody autoryzacyjne (np. BLIK), czy zalogował się przez fałszywy link?</div></div>`,
                `<div class="section-heading">V. Przekazanie środków (Ślady finansowe - KLUCZOWE!)</div><div class="sub-section"><div>- Z jakiego banku i z jakiego numeru konta (IBAN) pokrzywdzony wysłał środki?</div></div><div class="sub-section"><div>- Na jakie dokładnie konto (IBAN) lub telefon trafiły pieniądze?</div></div><div class="sub-section"><div>- Jeśli ofiara wypłaciła gotówkę w bankomacie, to w jakim i o której godzinie?</div></div>`,
                `<div class="section-heading">VI. Narzędzia i dowody zabezpieczone</div><div class="sub-section"><div>- Czy sprawca polecił zainstalować na telefonie program do zdalnej obsługi? (AnyDesk, itp.).</div></div><div class="sub-section"><div>- Obowiązkowo zabezpieczyć: zrzuty ekranu korespondencji, fałszywe linki, SMS-y oraz <b>potwierdzenia przelewów w formacie PDF</b>.</div></div>`,
                `<div class="section-heading">VII. Kto? (Identyfikacja)</div><div class="sub-section"><div>- Dane pokrzywdzonego i ew. dane banku.</div></div><div class="sub-section"><div>- Jeśli doszło do osobistego przekazania gotówki (tzw. "odbierak"): Jak wyglądała osoba odbierająca pieniądze?</div></div>`,
                `<div class="section-heading">VIII. Inne (Wniosek o ściganie)</div><div class="sub-section"><div>- Warto zabezpieczyć w protokole oświadczenie woli ścigania.</div></div>`
            ],
            documents: standardDocumentsList
        }
    ];

    function searchCrime() {
        const query = document.getElementById("searchInput").value.toLowerCase();
        const resultsDiv = document.getElementById("resultsList");
        resultsDiv.innerHTML = "";
        if (query.trim() === "") return;
        const results = crimeDatabase.filter(crime => crime.keywords.some(k => k.includes(query)));
        
        if (results.length > 0) {
            results.forEach(crime => {
                const div = document.createElement("div");
                div.className = "result-item";
                div.innerHTML = `<strong>${crime.title}</strong>`;
                div.onclick = () => buildAlgorithmView(crime);
                resultsDiv.appendChild(div);
            });
        } else {
            resultsDiv.innerHTML = "<p style='padding: 10px; color: #d9534f; font-weight: bold;'>Nie znaleziono algorytmu.</p>";
        }
    }

    function buildAlgorithmView(crime) {
        currentAlgorithm = crime;
        document.getElementById("search-view").style.display = "none";
        document.getElementById("algorithm-view").style.display = "block";
        document.getElementById("crimeTitle").innerText = crime.title;

        const quoteDiv = document.getElementById("articleQuote");
        if (crime.articleText) {
            quoteDiv.innerHTML = usunWdowy(crime.articleText);
            quoteDiv.style.display = "block";
        } else {
            quoteDiv.style.display = "none";
        }

        const menuContainer = document.getElementById("algorithm-menu");
        const phaseContainer = document.getElementById("algorithm-phase-content");
        
        menuContainer.style.display = "block";
        phaseContainer.style.display = "none";
        menuContainer.innerHTML = "";
        phaseContainer.innerHTML = "";

        // Przycisk dokumentów (rozwijany) w menu głównym algorytmu
        if (crime.documents && crime.documents.length > 0) {
            let docBtn = document.createElement("button");
            docBtn.className = "accordion-btn";
            docBtn.style.backgroundColor = "#fff8e1";
            docBtn.style.border = "1px solid #fecb00";
            docBtn.innerHTML = "📄 Wykaz niezbędnych dokumentów procesowych <span>▼</span>";
            docBtn.onclick = function() { this.nextElementSibling.classList.toggle("hidden"); };
            menuContainer.appendChild(docBtn);
            
            let docContent = document.createElement("div");
            docContent.className = "accordion-content hidden";
            crime.documents.forEach(d => { docContent.innerHTML += `<div style="margin: 6px 0;">🔹 ${d}</div>`; });
            menuContainer.appendChild(docContent);
        }

        // Zielony akordeon WZORY (dodawany do menu, pod dokumentami)
        if (crime.wzory && crime.wzory.length > 0) {
            let wzorBtn = document.createElement("button");
            wzorBtn.className = "accordion-btn";
            wzorBtn.style.backgroundColor = "#e8f5e9";
            wzorBtn.style.border = "1px solid #4caf50";
            wzorBtn.style.color = "#2e7d32";
            wzorBtn.style.marginTop = "8px";
            wzorBtn.innerHTML = "📝 Wzory wypełnionych protokołów <span>▼</span>";
            wzorBtn.onclick = function() { this.nextElementSibling.classList.toggle("hidden"); };
            menuContainer.appendChild(wzorBtn);

            let wzorContent = document.createElement("div");
            wzorContent.className = "accordion-content hidden";
            wzorContent.style.borderLeftColor = "#4caf50";
            wzorContent.style.backgroundColor = "#fcfdfc";
            crime.wzory.forEach(w => { wzorContent.innerHTML += `<div style="margin: 6px 0;">${w}</div>`; });
            menuContainer.appendChild(wzorContent);
        }

        // Przyciski menu (Fazy)
        if (crime.isInteractive && crime.phases) {
            crime.phases.forEach((phaseHTML, index) => {
                let phaseBtn = document.createElement("button");
                phaseBtn.className = "btn-primary";
                phaseBtn.style.marginTop = "8px";
                let title = index === 0 ? "ETAP 1: Faza Wstępna" : (index === 1 ? "ETAP 2: Faza Główna" : "ETAP 3: Faza Końcowa");
                phaseBtn.innerText = title;
                phaseBtn.onclick = () => openPhase(index);
                menuContainer.appendChild(phaseBtn);
            });
        } else {
            let stepBtn = document.createElement("button");
            stepBtn.className = "btn-primary";
            stepBtn.style.marginTop = "8px";
            stepBtn.innerText = "Pokaż algorytm postępowania";
            stepBtn.onclick = () => openStandardSteps();
            menuContainer.appendChild(stepBtn);
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
</script>
</body>
</html>
